{
  // Cloudflare Worker config. Free tier: 100k requests/day, KV 100k reads + 1k writes/day.
  "name": "health-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    // Stores OAuth clients/grants (encrypted) and the cached Garmin access token.
    // Create with: npx wrangler kv namespace create OAUTH_KV  -> paste the id here.
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  "vars": {
    // Exactly the URL Claude connects to. Tokens are bound to it.
    "MCP_RESOURCE": "https://health-mcp.REPLACE_WITH_SUBDOMAIN.workers.dev/mcp",
    // The only Google account allowed to sign in.
    "ALLOWED_EMAIL": "REPLACE_WITH_YOUR_GMAIL"
  }
  // Secrets (never in this file), set with `npx wrangler secret put NAME`:
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GARMIN_API_KEY, CONSENT_SECRET
}
